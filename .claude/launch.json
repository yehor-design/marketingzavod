{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "next-dev-tracking",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "NEXT_PUBLIC_TRACKING_DEBUG=true",
        "NEXT_PUBLIC_AMPLITUDE_API_KEY=",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3001"
      ],
      "port": 3001
    }
  ]
}
