# Environment variables for marketingzavod.com. Copy to .env.local for local work.
# Real values live in Vercel → Project marketingzavod → Settings → Environment Variables (Production).
# Every integration stays inactive while its variable is empty.
# Full reference: docs/tracking-plan.md

# --- Site -------------------------------------------------------------------
# Canonical origin. Defaults to https://www.marketingzavod.com
NEXT_PUBLIC_SITE_URL=
# Fallback Search Console verification (meta tag). DNS verification is preferred.
NEXT_PUBLIC_GSC_VERIFICATION=
# Set to "true" to let tracking run outside production (preview, local).
NEXT_PUBLIC_TRACKING_DEBUG=

# --- Public identifiers -------------------------------------------------------
# Google Tag Manager carries GA4, Google Ads, Meta Pixel and LinkedIn (gtm/container.json).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# Amplitude project API key (public): product analytics and session recordings.
# Amplitude loads only with statistics consent. The server sends lead_saved and
# the consent log to Amplitude with the same key.
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CONTACT=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_WAITLIST=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CHECKOUT=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CONTACT_CLICK=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_CONTACT=
NEXT_PUBLIC_LINKEDIN_CONVERSION_WAITLIST=

# --- Secrets (server only, never NEXT_PUBLIC_) --------------------------------
META_CAPI_ACCESS_TOKEN=
HUBSPOT_ACCESS_TOKEN=
# Client secret of the HubSpot app. Verifies webhook signatures (optional webhook path).
HUBSPOT_CLIENT_SECRET=
# Vercel Cron sends it to /api/cron/offline-conversions; other callers are refused.
CRON_SECRET=
# Password for the Google Ads scheduled upload of offline conversions.
OFFLINE_CONVERSIONS_SECRET=
# Resend API key for transactional email on marketingzavod.com.
RESEND_API_KEY=
# Bearer secret gating POST /api/email/verify for operational sending checks.
EMAIL_VERIFY_SECRET=

# --- Optional settings (not secret) -------------------------------------------
# Sender address for Resend. Defaults to Marketing Zavod <noreply@marketingzavod.com>
RESEND_FROM=
# Recipient mailbox used only by POST /api/email/verify.
RESEND_VERIFY_TO=
# Test code from Meta Events Manager → Test Events. Remove after testing.
META_TEST_EVENT_CODE=
# HubSpot pipeline and stage IDs. Defaults match the default sales pipeline.
HUBSPOT_PIPELINE=
HUBSPOT_DEAL_STAGE_NEW=
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_WON=
