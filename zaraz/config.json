            "__zaraz_setting_name": "view_pricing",
            "en": "view_pricing",
            "billing_period": "{{ client.billing_period }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "ctaClick": {
          "actionType": "event",
          "firingTriggers": [
            "evCtaClick"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "cta_click",
            "en": "cta_click",
            "cta_text": "{{ client.cta_text }}",
            "cta_location": "{{ client.cta_location }}",
            "destination": "{{ client.destination }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "contactClick": {
          "actionType": "event",
          "firingTriggers": [
            "evContactClick"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "contact_click",
            "en": "contact_click",
            "method": "{{ client.method }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "outboundClick": {
