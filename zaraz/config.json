            "__zaraz_setting_name": "form_start",
            "en": "form_start",
            "form_name": "{{ client.form_name }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "formError": {
          "actionType": "event",
          "firingTriggers": [
            "evFormError"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "form_error",
            "en": "form_error",
            "form_name": "{{ client.form_name }}",
            "field": "{{ client.field }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "faqOpen": {
          "actionType": "event",
          "firingTriggers": [
            "evFaqOpen"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "faq_open",
            "en": "faq_open",
            "question": "{{ client.question }}",
            "event_id": "{{ client.event_id }}"
          }
        }
      }
    }
  },
