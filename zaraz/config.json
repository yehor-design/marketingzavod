{
  "consent": {
    "enabled": true,
    "hideModal": true,
    "cookieName": "wb_zaraz_consent",
    "defaultLanguage": "en",
    "customIntroDisclaimerDismissed": true,
    "tcfCompliant": false,
    "purposesWithTranslations": {
      "statistics": {
        "name": {
          "en": "Statistics"
        },
        "description": {
          "en": "Google Analytics 4"
        },
        "order": 0
      },
      "marketing": {
        "name": {
          "en": "Marketing"
        },
        "description": {
          "en": "Google Ads, LinkedIn"
        },
        "order": 1
      }
    }
  },
  "dataLayer": false,
  "historyChange": false,
  "settings": {
    "autoInjectScript": false,
    "cookieDomain": "heywowboy.com",
    "ecommerce": false,
    "hideExternalReferer": false,
    "hideIPAddress": false,
    "hideQueryParams": false,
    "hideUserAgent": false,
    "injectIframes": false
  },
  "analytics": {
    "enabled": true,
    "defaultPurpose": "statistics",
    "sessionExpTime": 1800
  },
  "tools": {
    "ga4": {
      "type": "component",
      "component": "google-analytics_v4",
      "name": "Google Analytics 4",
      "enabled": true,
      "defaultPurpose": "statistics",
      "permissions": [
        "access_client_kv",
        "server_network_requests"
      ],
      "settings": {
        "tid": "G-FC7QKZ0DYD",
        "hideOriginalIP": false,
        "ecommerce": false,
        "ga-audiences": false
      },
      "defaultFields": {},
      "blockingTriggers": [],
      "actions": {
        "pageView": {
          "actionType": "pageview",
          "firingTriggers": [
            "evPageView"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "page_view",
            "page_location": "{{ client.page_location }}",
            "page_path": "{{ client.page_path }}",
            "page_title": "{{ client.page_title }}",
            "event_id": "{{ client.event_id }}",
            "dl": "{{ client.page_location }}",
            "dt": "{{ client.page_title }}"
          }
        },
        "generateLead": {
          "actionType": "event",
          "firingTriggers": [
            "evGenerateLead"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "generate_lead",
            "en": "generate_lead",
            "form_name": "{{ client.form_name }}",
            "lead_id": "{{ client.lead_id }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "joinWaitlist": {
          "actionType": "event",
          "firingTriggers": [
            "evJoinWaitlist"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "join_waitlist",
            "en": "join_waitlist",
            "form_name": "{{ client.form_name }}",
            "lead_id": "{{ client.lead_id }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "submitApplication": {
          "actionType": "event",
          "firingTriggers": [
            "evSubmitApplication"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "submit_application",
            "en": "submit_application",
            "form_name": "{{ client.form_name }}",
            "lead_id": "{{ client.lead_id }}",
            "role": "{{ client.role }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "beginCheckout": {
          "actionType": "event",
          "firingTriggers": [
            "evBeginCheckout"
          ],
          "blockingTriggers": [],
          "data": {
            "__zaraz_setting_name": "begin_checkout",
            "en": "begin_checkout",
            "plan": "{{ client.plan }}",
            "value": "{{ client.value }}",
            "currency": "{{ client.currency }}",
            "event_id": "{{ client.event_id }}"
          }
        },
        "viewPricing": {
          "actionType": "event",
          "firingTriggers": [
            "evViewPricing"
          ],
          "blockingTriggers": [],
